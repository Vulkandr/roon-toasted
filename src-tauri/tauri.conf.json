{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "roon-toasted",
  "version": "0.1.0",
  "identifier": "com.vulkan.roon-toasted",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "toaster",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-lcd-text",
        "url": "toaster.html",
        "title": "Roon: Toasted",
        "width": 460,
        "height": 935,
        "minWidth": 400,
        "minHeight": 872,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "minimizable": false
      },
      {
        "label": "settings",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-lcd-text",
        "url": "settings.html",
        "title": "Roon: Toasted Settings",
        "width": 1100,
        "height": 811,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "toast",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-lcd-text",
        "url": "toast.html",
        "title": "Roon: Toasted",
        "width": 374,
        "height": 101,
        "center": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
